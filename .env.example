# Backend
DATABASE_URL=postgresql+psycopg://rto:rto@postgres:5432/rto
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REDIS_URL=redis://redis:6379/0

# SMS-агрегатор: console (по умолчанию, код только в лог) | smsru (нужен SMS_API_KEY)
# Devino/SMSC пока не реализованы — окончательный выбор за пользователем.
SMS_PROVIDER=console
SMS_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# S3 (Selectel)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=rto-files

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
